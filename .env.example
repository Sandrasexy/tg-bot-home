# Telegram bot token from @BotFather
TELEGRAM_TOKEN=your_bot_token_here

# Anthropic API key for expense parsing (required)
ANTHROPIC_API_KEY=your_anthropic_key_here

# OpenAI API key for voice transcription (optional)
OPENAI_API_KEY=your_openai_key_here

# Telegram user IDs of the two housemates
USER1_ID=123456789
USER2_ID=987654321

# Display names
USER1_NAME=Иван
USER2_NAME=Мария

# Optional: group chat ID to post balance updates
# Leave empty to only reply in the chat where expense was sent
NOTIFY_CHAT_ID=

# SQLite database path
DB_PATH=expenses.db
